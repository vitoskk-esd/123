# Скопируйте в .env и заполните (файл .env не попадает в git)
# Нужен только kwork_agent (автозагрузчик) и боту при KWORK_BOT_LLM=claude
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# --- Telegram-бот (python -m kwork_bot) ---
# Токен от @BotFather
KWORK_BOT_TOKEN=
# Ваш Telegram ID через запятую (необязательно: иначе владельцем станет первый, кто напишет боту /start)
KWORK_BOT_ADMINS=
# 1 — все пользуются бесплатно (бета-тест)
KWORK_BOT_FREE_ACCESS=0
KWORK_BOT_PRICE_RUB=3000
KWORK_BOT_RETURN_URL=https://t.me/имя_вашего_бота
# Кто пишет тексты: gemini (по умолчанию) или claude
KWORK_BOT_LLM=gemini
# Ключ Gemini: aistudio.google.com → Get API key (бесплатно). В облачной среде Claude Code не нужен
GEMINI_API_KEY=
# Модели (по умолчанию gemini-3.5-flash; при перегрузке — запасные по очереди)
# KWORK_BOT_MODEL=gemini-3.5-flash
# KWORK_BOT_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
# Обложки: ключ Higgsfield API из личного кабинета (там же, где баланс), формат key-id:key-secret.
# Без ключа — бесплатные градиентные обложки
HF_KEY=
# Сколько ИИ-фонов на человека (обложки чередуют их; текст рисуется бесплатно)
KWORK_BOT_BACKGROUNDS=4
KWORK_BOT_IMAGE_MODEL=recraft/v4.1/text-to-image
# ЮKassa: yookassa.ru → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — отправлять чеки (бот спросит e-mail покупателя)
YOOKASSA_RECEIPTS=0
