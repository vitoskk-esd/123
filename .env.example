# Скопируйте в .env и заполните (файл .env не попадает в git)
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# --- Telegram-ассистент (tg_agent) ---
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Ваш канал — ассистент упомянет его в личке, только если спросят
TG_MY_CHANNEL=@your_channel
# Кто вы и в чём эксперт — от этого зависит голос комментариев
# TG_PERSONA=практик в автоматизации бизнеса с помощью ИИ ...
# Лимит опубликованных комментариев в сутки
TG_MAX_COMMENTS_PER_DAY=15
# Каналы без черновиков и группы, где следить за всей беседой (через запятую)
# TG_SKIP_CHANNELS=@news_channel
# TG_WATCH_GROUPS=@my_chat
