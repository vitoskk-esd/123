# Скопируйте в .env и заполните (файл .env не попадает в git)
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# ===== fashion_bot — бот модного канала (подробно: FASHION_BOT.md) =====
# 1 — ничего не публиковать, присылать готовые посты в TELEGRAM_ADMIN_CHAT (для первой проверки)
FASHION_DRY_RUN=1
SHOP_NAME=MY BRAND STORE
# Подпись в конце каждого поста
SHOP_CTA=Оригиналы в наличии и под заказ — @my_shop
# FASHION_FOCUS=кроссовки Nike, Jordan, adidas, New Balance; стритвир; люкс ...
# Водяной знак: PNG-логотип с прозрачным фоном или текст (по умолчанию SHOP_NAME)
# WATERMARK_LOGO=fashion_bot/logo.png
# WATERMARK_POSITION=bottom-right
# WATERMARK_OPACITY=0.8
# Telegram: токен от @BotFather, бот — администратор канала
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@my_channel
# Ваш chat id (узнать: @userinfobot) — ошибки и посты на проверку
TELEGRAM_ADMIN_CHAT=
# Instagram (профессиональный аккаунт, официальный API)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Хостинг фото для Instagram: ключ с https://api.imgbb.com
IMGBB_API_KEY=
# FASHION_MAX_POSTS_PER_DAY=6
# FASHION_INTERVAL_MIN=120
# FASHION_ACTIVE_HOURS=9-22
# FASHION_BOT_MODEL=claude-opus-5-5
