# Скопируйте в .env и заполните (файл .env не попадает в git)
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# --- Telegram-бот (python -m kwork_bot) ---
# Токен от @BotFather
KWORK_BOT_TOKEN=
# Ваш Telegram ID через запятую (необязательно: иначе владельцем станет первый, кто напишет боту /start)
KWORK_BOT_ADMINS=
# 1 — все пользуются бесплатно (бета-тест)
KWORK_BOT_FREE_ACCESS=0
KWORK_BOT_PRICE_RUB=3000
KWORK_BOT_RETURN_URL=https://t.me/имя_вашего_бота
# claude-opus-5-5 — лучше тексты, claude-sonnet-5-5 — примерно вдвое дешевле
KWORK_BOT_MODEL=claude-opus-5-5
# ЮKassa: yookassa.ru → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — отправлять чеки (бот спросит e-mail покупателя)
YOOKASSA_RECEIPTS=0
