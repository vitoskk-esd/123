# Скопируйте в .env и заполните (файл .env не попадает в git)
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# ===== bank_agent: продвижение банковских продуктов (см. BANK_AGENT.md) =====
# 1 — готовить посты, но не публиковать (для первой проверки)
BANK_DRY_RUN=1
BANK_GOAL=100
# BANK_GOAL_DEADLINE=2026-10-31
# Публичный адрес счётчика переходов (сервер с `python -m bank_agent serve`)
BANK_TRACKER_URL=
# Секрет для обезличивания id и IP — замените на случайную строку
BANK_SALT=change-me
# Ваши id в мессенджерах: туда агент шлёт отчёты, оттуда принимает /conv и /stats
BANK_ADMIN_TELEGRAM=
BANK_ADMIN_MAX=
BANK_ADMIN_VK=
# BANK_OWNER_NAME=Иван
# BANK_CHANNEL_POSTS=telegram:2,vk:2,max:2,dzen:1,shorts:2
# BANK_POST_TIMES=09:30,13:00,19:30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
MAX_BOT_TOKEN=
MAX_CHANNEL_ID=
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_USER_TOKEN=
