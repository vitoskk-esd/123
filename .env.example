# Скопируйте в .env и заполните (файл .env не попадает в git)
ANTHROPIC_API_KEY=sk-ant-...
KWORK_LOGIN=
KWORK_PASSWORD=
# 1 — заполнять форму, но не отправлять на модерацию (для первой проверки)
KWORK_DRY_RUN=1
# План: 15 объявлений в первый день, +3 каждый день (если вчера всё прошло), максимум 45
KWORK_START_PER_DAY=15
KWORK_DAILY_INCREASE=3
KWORK_MAX_PER_DAY=45
# KWORK_AGENT_MODEL=claude-opus-5
# KWORK_NICHE=автоматизация бизнес-процессов с помощью ИИ, контент-заводы ...

# --- Telegram-ассистент (tg_agent) ---
# Модель для комментариев: claude или yandex (YandexGPT, доступен из РФ, оплата в рублях)
TG_LLM_PROVIDER=claude
# Для yandex: Yandex Cloud → каталог (его ID) → сервисный аккаунт с ролью ai.languageModels.user → API-ключ
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt/latest
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Если my.telegram.org выдаёт ERROR — оставьте два поля выше пустыми и включите это
# (ключи официального Telegram Desktop, есть риск ограничений, см. TG_AGENT.md)
# TG_USE_DESKTOP_KEYS=1
# Ваш канал — под его постами ассистент не комментирует
TG_MY_CHANNEL=@your_channel
# Кто вы и в чём эксперт — от этого зависит голос комментариев
# TG_PERSONA=практик в автоматизации бизнеса с помощью ИИ ...
# Комментарий через случайные 3–5 минут после поста
TG_DELAY_MIN_MINUTES=3
TG_DELAY_MAX_MINUTES=5
# Пауза между своими комментариями, если посты вышли одновременно
TG_GAP_MIN_MINUTES=2
TG_GAP_MAX_MINUTES=4
# Лимит комментариев в сутки
TG_MAX_COMMENTS_PER_DAY=15
# Каналы без комментариев (через запятую)
# TG_SKIP_CHANNELS=@news_channel
# 1 — присылать в «Избранное» отчёт о каждом комментарии
TG_REPORT=1
