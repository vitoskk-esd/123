  <svg id="bg" width="1080" height="1920" viewBox="0 0 1080 1920" style="position:absolute;left:0;top:0">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#05070f"/><stop offset=".55" stop-color="#1a1030"/><stop offset="1" stop-color="#4d1e3c"/></linearGradient>
      <radialGradient id="cone" cx=".5" cy="0" r="1"><stop offset="0" stop-color="#ffd27a" stop-opacity=".55"/><stop offset="1" stop-color="#ffd27a" stop-opacity="0"/></radialGradient>
      <linearGradient id="wet" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a2e36"/><stop offset="1" stop-color="#15171c"/></linearGradient>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
    </defs>
    <rect width="1080" height="1100" fill="url(#sky)"/>
    <g fill="#ffffff" opacity=".6"><circle cx="120" cy="180" r="2"/><circle cx="310" cy="120" r="1.6"/><circle cx="520" cy="210" r="2"/><circle cx="760" cy="150" r="1.6"/><circle cx="950" cy="260" r="2.2"/><circle cx="640" cy="320" r="1.4"/><circle cx="200" cy="400" r="1.6"/></g>
    <g fill="#10131b" stroke="#000" stroke-width="5"><rect x="0" y="760" width="170" height="300"/><rect x="180" y="820" width="120" height="240"/><rect x="800" y="780" width="130" height="280"/><rect x="940" y="700" width="140" height="360"/></g>
    <g fill="#ffcf5a"><rect x="30" y="800" width="26" height="30" opacity=".9"/><rect x="110" y="860" width="26" height="30" opacity=".6"/><rect x="30" y="920" width="26" height="30" opacity=".35"/><rect x="210" y="860" width="24" height="28" opacity=".8"/><rect x="830" y="820" width="24" height="28" opacity=".7"/><rect x="880" y="900" width="24" height="28" opacity=".9"/><rect x="980" y="740" width="24" height="28" opacity=".8"/><rect x="1030" y="820" width="24" height="28" opacity=".5"/></g>
    <!-- неоновая вывеска -->
    <g><rect x="310" y="830" width="460" height="200" fill="#14161c" stroke="#000" stroke-width="6"/><rect x="300" y="790" width="480" height="76" rx="12" fill="#0a0b0f" stroke="#000" stroke-width="6"/>
      <text x="540" y="845" text-anchor="middle" font-family="Unbounded" font-weight="900" font-size="44" fill="#ff2e55" filter="url(#glow)">АВТОРЫНОК</text>
      <text x="540" y="845" text-anchor="middle" font-family="Unbounded" font-weight="900" font-size="44" fill="#ff8aa0">АВТОРЫНОК</text>
      <rect x="350" y="900" width="110" height="80" fill="#3a2a10"/><rect x="620" y="900" width="110" height="80" fill="#ffcf5a" opacity=".5"/></g>
    <!-- фонари со светом -->
    <g><path d="M70 1060 V640 h70" stroke="#0a0b0f" stroke-width="12" fill="none"/><path d="M1010 1060 V620 h-70" stroke="#0a0b0f" stroke-width="12" fill="none"/>
      <ellipse cx="140" cy="650" rx="26" ry="12" fill="#ffe7a8"/><ellipse cx="940" cy="630" rx="26" ry="12" fill="#ffe7a8"/>
      <path d="M140 650 L-60 1500 L360 1500 Z" fill="url(#cone)"/><path d="M940 630 L720 1500 L1140 1500 Z" fill="url(#cone)"/></g>
    <!-- машины вдали с фарами -->
    <g stroke="#000" stroke-width="5"><path d="M-20 1060 q4 -40 40 -46 l50 -36 h90 l50 36 q36 6 40 46 z" fill="#1d2230"/><path d="M760 1060 q4 -40 40 -46 l50 -36 h90 l50 36 q36 6 40 46 z" fill="#2a1d24"/></g>
    <g fill="#fff6c8"><circle cx="230" cy="1040" r="9"/><circle cx="770" cy="1040" r="9"/></g>
    <rect y="1050" width="1080" height="870" fill="url(#wet)"/>
    <g stroke="#3a3f48" stroke-width="10" opacity=".7"><path d="M40 1700 l120 -320 M420 1700 l60 -320 M680 1700 l-20 -320 M1040 1700 l-90 -320"/></g>
    <g opacity=".22"><rect x="120" y="1520" width="40" height="300" fill="#ffd27a"/><rect x="920" y="1500" width="40" height="320" fill="#ffd27a"/><rect x="520" y="1560" width="30" height="240" fill="#ff2e55"/></g>
    <rect y="1640" width="1080" height="280" fill="#101215" opacity=".6"/>
  </svg>
