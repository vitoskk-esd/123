   "pause": 0.3
  },
  {
   "id": "l3",
   "who": "lis",
   "text": "Тогда Жора решил продать свою Камри — со скрученным пробегом.",
   "gap": 0.12,
   "pause": 0.3
  },
  {
   "id": "r0",
   "who": "ref",
   "text": "Стоп, игра! Смотрим повтор!",
