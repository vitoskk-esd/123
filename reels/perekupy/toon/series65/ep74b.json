 "lines": [
  {
   "id": "l0",
   "who": "lis",
   "text": "Финал сезона: «Перехват» против «Перекупов». Разыгрывается Камри — ниже рынка.",
   "gap": 0.12,
   "pause": 0.3
  },
  {
   "id": "k0",
   "who": "vad",
   "text": "Объявление вышло! Мяч в игре!",
   "gap": 0.12,
   "pause": 0.3
  },
  {
   "id": "l1",
   "who": "lis",
   "text": "Стасу бот прислал машину через секунду.",
