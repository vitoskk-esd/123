  {
   "id": "s0",
   "who": "stas",
   "text": "Уже звоню продавцу!",
   "gap": 0.12,
   "pause": 0.3
  },
  {
   "id": "k1",
   "who": "vad",
   "text": "Гол! Один — ноль! Стас уже договорился о просмотре!",
   "gap": 0.12,
   "pause": 0.3
  },
  {
   "id": "l2",
   "who": "lis",
   "text": "Жора увидел объявление через сорок минут.",
