# Скопируй в .env и заполни. Файл .env не коммитить.
BOT_TOKEN=            # токен бота от @BotFather
ADMIN_IDS=            # твой Telegram ID (узнать: @userinfobot); несколько — через запятую

# Служебный аккаунт, который читает каналы: my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSIONS=main      # несколько аккаунтов — через запятую: main,second (каждый — до 500 каналов)
# Закрытый канал-буфер: служебный аккаунт и бот — его админы. Id вида -1001234567890
# (перешли любое сообщение из канала боту @userinfobot или @getidsbot)
BUFFER_CHANNEL_ID=
JOIN_INTERVAL=90      # пауза между вступлениями в каналы, сек — меньше не ставь
# Telegram пропускает ~30 сообщений/с на бота. Когда на одну машину подходит больше ~30 человек, последние ждут.
# 1 — платная рассылка Telegram (до 1000/с, сверх бесплатного лимита платится звёздами с баланса бота)
PAID_BROADCAST=0

# Подписка
PRICE_RUB=990
PERIOD_DAYS=30
TRIAL_DAYS=3
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_AUTOPAY=0    # 1 — автопродление (сначала включи рекуррентные платежи в ЮKassa)
YOOKASSA_RECEIPTS=0
RETURN_URL=https://t.me/имя_твоего_бота
OFFER_URL=            # ссылка на оферту — для ЮKassa обязательна
SUPPORT_CONTACT=      # @ник поддержки

# ИИ для постов, которые не разобрали правила (aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_FALLBACK=1

DB_PATH=data/bot.db
