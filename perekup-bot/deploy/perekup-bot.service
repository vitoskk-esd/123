# systemd: бот работает круглосуточно и сам поднимается после сбоя или перезагрузки сервера.
# Установка (на сервере, от root):  cp deploy/perekup-bot.service /etc/systemd/system/ && systemctl enable --now perekup-bot
[Unit]
Description=Perekhvat bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/perekup-bot
ExecStart=/opt/perekup-bot/venv/bin/python -m bot
Restart=always
RestartSec=5
User=perekup

[Install]
WantedBy=multi-user.target
