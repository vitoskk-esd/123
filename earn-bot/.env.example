# Скопируй в .env и заполни. Файл .env не коммитить.
BOT_TOKEN=            # токен нового бота от @BotFather (не тот, что для уведомлений)
ADMIN_IDS=            # твой Telegram ID (узнать: @userinfobot); несколько — через запятую
DB_PATH=data/bot.db
OFFERS_PATH=offers.yaml
MIN_PAYOUT=300        # минимальная сумма вывода, ₽
PRIVACY_URL=          # ссылка на политику обработки данных (telegra.ph или Google Docs)
